{
  "schema_version": 1,
  "status": "ready",
  "python": "3.12",
  "requirements": [],
  "inputs": [
    "scripts/certify_rational_rank.py",
    "scripts/compare_recursive_invoices.py"
  ],
  "commands": [
    {
      "argv": [
        "{python}",
        "-W",
